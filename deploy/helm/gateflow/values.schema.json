{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "properties": {
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "startup": { "$ref": "#/definitions/probe" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "environment": {
      "enum": [
        "kind",
        "aws"
      ]
    },
    "imageTag": {
      "type": "string",
      "minLength": 1
    },
    "secretName": {
      "type": "string",
      "minLength": 1
    },
    "bootstrapSecretName": {
      "type": "string",
      "minLength": 1
    },
    "ingress": {
      "type": "object",
      "properties": {
        "inboundCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "allowAnySource": {
          "type": "boolean"
        }
      }
    },
    "shutdown": {
      "type": "object",
      "properties": {
        "preStop": {
          "type": "integer",
          "minimum": 1
        },
        "drain": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "margin": {
          "type": "integer",
          "minimum": 1
        },
        "grace": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "databaseMaxConns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "probes": { "$ref": "#/definitions/probes" }
        }
      }
    },
    "probes": { "$ref": "#/definitions/probes" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetPerReplica": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requestDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "serverAddress": {
          "type": "string",
          "pattern": "^https?://[^\\s\"]+$"
        },
        "job": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "rateWindow": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[smh]$"
        },
        "maxSampleAgeSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
