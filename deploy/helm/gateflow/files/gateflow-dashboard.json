        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "profile",
        "label": "Profile",
        "type": "textbox",
        "current": {
          "text": "mock-load",
          "value": "mock-load"
        },
        "query": "mock-load",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "config",
        "label": "Configuration",
        "type": "textbox",
        "current": {
          "text": "record SHA / values hash",
          "value": "record SHA / values hash"
        },
        "query": "record SHA / values hash",
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "duration",
        "label": "Mean duration D (s)",
        "type": "textbox",
        "current": {
          "text": "20",
